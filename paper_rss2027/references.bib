@article{zhaole_robust_2024,
	title = {A {Robust} {Deformable} {Linear} {Object} {Perception} {Pipeline} in {3D}: {From} {Segmentation} to {Reconstruction}},
	volume = {9},
	issn = {2377-3766},
	shorttitle = {A {Robust} {Deformable} {Linear} {Object} {Perception} {Pipeline} in {3D}},
	url = {https://ieeexplore.ieee.org/document/10333979/},
	doi = {10.1109/LRA.2023.3337695},
	abstract = {3D perception of deformable linear objects (DLOs) is crucial for DLO manipulation. However, perceiving DLOs in 3D from a single RGBD image is challenging. Previous DLO perception methods fail to extract a decent 3D DLO model due to different textures, occlusions, sparse and false depth information. To address these problems and provide a more robust DLO perception initialization for downstream tasks like tracking and manipulation in complex scenarios, this letter proposes a 3D DLO perception pipeline to first segment a DLO in 2D images and post-process masks to eliminate false positive segmentation, reconstruct the DLO in 3D space to predict the occluded part of the DLO, and physically smooth the reconstructed DLO. By testing on a synthetic DLO dataset and further validating on a real-world dataset with seven different DLOs, we demonstrate that the proposed method is an effective and robust 3D perception pipeline solution with better performance on 2D DLO segmentation and 3D DLO reconstruction compared to State-of-the-Art algorithms.},
	number = {1},
	urldate = {2026-02-01},
	journal = {IEEE Robotics and Automation Letters},
	author = {Zhaole, Sun and Zhou, Hang and Nanbo, Li and Chen, Longfei and Zhu, Jihong and Fisher, Robert B.},
	month = jan,
	year = {2024},
	keywords = {Image reconstruction, Image segmentation, Pipelines, Point cloud compression, RGB-D perception, Skeleton, State estimation, Three-dimensional displays, perception for grasping and manipulation},
	pages = {843--850},
}

@inproceedings{monguzzi_tactile_2023,
	title = {Tactile based robotic skills for cable routing operations},
	url = {https://ieeexplore.ieee.org/document/10160729/},
	doi = {10.1109/ICRA48891.2023.10160729},
	abstract = {This paper proposes a set of tactile based skills to perform robotic cable routing operations for deformable linear objects (DLOs) characterized by considerable stiffness and constrained at both ends. In particular, tactile data are exploited to reconstruct the shape of the grasped portion of the DLO and to estimate the future local one. This information is exploited to obtain a grasping configuration aligned to the local shape of the DLO, starting from a rough initial grasping pose, and to follow the DLO's contour in the three-dimensional space. Taking into account the distance travelled along the arc length of the DLO, the robot can detect the cable segments that must be firmly grasped and inserted in intermediate clips, continuing then to slide along the contour until the next DLO's portion, that has to be clipped, is reached. The proposed skills are experimentally validated with an industrial robot on different DLOs in several configurations and on a cable routing use case.},
	urldate = {2026-02-01},
	booktitle = {2023 {IEEE} {International} {Conference} on {Robotics} and {Automation} ({ICRA})},
	author = {Monguzzi, Andrea and Pelosi, Martina and Zanchettin, Andrea Maria and Rocco, Paolo},
	month = may,
	year = {2023},
	keywords = {Automation, Grasping, Industrial robots, Routing, Service robots, Shape, Three-dimensional displays},
	pages = {3793--3799},
}

@article{xia_review_2022,
	title = {A review on sensory perception for dexterous robotic manipulation},
	volume = {19},
	issn = {1729-8806},
	url = {https://doi.org/10.1177/17298806221095974},
	doi = {10.1177/17298806221095974},
	abstract = {Sensory perception for dexterous robotic hands is an active research area and recent progress in robotics. Effective dexterous manipulation requires robotic hands to accurately feedback their state or perceive the surrounding environment. This article reviews the state-of-the-art of sensory perception for dexterous robotic manipulation. Two types of sensors, such as intrinsic and extrinsic sensors, are introduced according to their function and layout in robotic hands. These sensors provide rich information to a robotic hand, which contains the posture, the contact information of objects, and the physical information of the environment. Then, a comprehensive analysis of perception methods including planning-level, control-level, and learning-level perceptions is presented. The information obtained from sensory perception can help robotic hands to make decisions effectively. Previously issued reviews mainly focus on the design of tactile senor, while we analyze and discuss the relationship among sensing, perception, and dexterous manipulation. Some potential research topics on sensory perception are also summarized and discussed.},
	language = {EN},
	number = {2},
	urldate = {2026-02-01},
	journal = {International Journal of Advanced Robotic Systems},
	publisher = {SAGE Publications},
	author = {Xia, Ziwei and Deng, Zhen and Fang, Bin and Yang, Yiyong and Sun, Fuchun},
	month = mar,
	year = {2022},
	pages = {17298806221095974},
}

@article{chen_tactile_2021,
	title = {Tactile {Velocity} {Estimation} for {Controlled} {In}-{Grasp} {Sliding}},
	volume = {6},
	issn = {2377-3766},
	url = {https://ieeexplore.ieee.org/document/9353219/},
	doi = {10.1109/LRA.2021.3058931},
	abstract = {This letter studies the problem of controlling the sliding motion of an object held by a robot manipulator. We show how a parallel-jaw gripper can reliably control the motion of a rigid, prism-like object by 1) estimating the object's sliding velocity using measurements from tactile sensors at the gripper's fingertips and 2) controlling the grip strength to regulate the sliding velocity. We first train a neural network to estimate the sliding velocity from only tactile signals with data of tactile sensor measurements associated with various sliding velocities determined by an external motion capture system from repeated sliding trials of 28 different objects varying in size, shape, and surface texture. The velocity estimates from the neural network are then used as feedback for a closed-loop grip controller that maintains the desired sliding velocity. Experimental results show that our neural network estimates the object's sliding velocity with mean squared error under 0.5 ({\textbackslash}textcm/s){\textasciicircum}2, generalizes well to objects of new shapes and surface textures, and enables our closed loop grip controller to reliably slide objects at different target velocities.},
	number = {2},
	urldate = {2026-02-01},
	journal = {IEEE Robotics and Automation Letters},
	author = {Chen, Yuan and Prepscius, Colin and Lee, Daewon and Lee, Daniel D.},
	month = apr,
	year = {2021},
	keywords = {Force and tactile sensing, Grippers, Neural networks, Robots, Shape, Tactile sensors, Task analysis, Velocity measurement, in-hand manipulation, machine learning for robot control},
	pages = {1614--1621},
}

@article{bergou_discrete_2008,
	title = {Discrete elastic rods},
	volume = {27},
	issn = {0730-0301},
	url = {https://dl.acm.org/doi/10.1145/1360612.1360662},
	doi = {10.1145/1360612.1360662},
	abstract = {We present a discrete treatment of adapted framed curves, parallel transport, and holonomy, thus establishing the language for a discrete geometric model of thin flexible rods with arbitrary cross section and undeformed configuration. Our approach differs from existing simulation techniques in the graphics and mechanics literature both in the kinematic description---we represent the material frame by its angular deviation from the natural Bishop frame---as well as in the dynamical treatment---we treat the centerline as dynamic and the material frame as quasistatic. Additionally, we describe a manifold projection method for coupling rods to rigid-bodies and simultaneously enforcing rod inextensibility. The use of quasistatics and constraints provides an efficient treatment for stiff twisting and stretching modes; at the same time, we retain the dynamic bending of the centerline and accurately reproduce the coupling between bending and twisting modes. We validate the discrete rod model via quantitative buckling, stability, and coupled-mode experiments, and via qualitative knot-tying comparisons.},
	number = {3},
	urldate = {2026-01-22},
	journal = {ACM Trans. Graph.},
	author = {Bergou, Miklós and Wardetzky, Max and Robinson, Stephen and Audoly, Basile and Grinspun, Eitan},
	month = aug,
	year = {2008},
	pages = {1--12},
}

@article{zhang_hardware_2022,
	title = {Hardware {Technology} of {Vision}-{Based} {Tactile} {Sensor}: {A} {Review}},
	volume = {22},
	issn = {1558-1748},
	shorttitle = {Hardware {Technology} of {Vision}-{Based} {Tactile} {Sensor}},
